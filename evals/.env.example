# Inspect's openai-api provider derives these names from the "ostiari" service
# prefix in model names such as openai-api/ostiari/claude-sonnet-4-6.
OSTIARI_BASE_URL=http://127.0.0.1:8421/v1

# The OpenAI client requires a value. In an auth-disabled local demo this can
# remain a placeholder. When OSTIARI_GATEWAY_AUTH=required, use a valid token
# whose asserted identity matches OSTIARI_EVAL_AGENT_ID.
OSTIARI_API_KEY=local-eval-placeholder
OSTIARI_EVAL_AGENT_ID=model-eval

# Make target defaults. The grader should be a different model/provider from
# the candidate so the candidate never silently grades itself.
OSTIARI_EVAL_MODEL=openai-api/ostiari/claude-sonnet-4-6
# OSTIARI_EVAL_GRADER_MODEL=anthropic/claude-sonnet-4-6

# Add the direct grader provider credential when using one.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
