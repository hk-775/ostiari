{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axonllm:standalone-ecs-context:v1",
  "title": "AxonLLM standalone ECS planning context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_id",
    "partition",
    "region",
    "source_revision",
    "release_evidence_ids",
    "image_reference",
    "platform",
    "providers",
    "provider_secrets",
    "task",
    "network",
    "state",
    "identity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "partition": {"enum": ["aws", "aws-cn", "aws-us-gov"]},
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2,8}(?:-[a-z0-9]+)+-[0-9]+$"
    },
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "image_reference": {"type": "string", "minLength": 1, "maxLength": 1024},
    "platform": {"enum": ["linux/amd64", "linux/arm64"]},
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "provider_secrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value_from"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "value_from": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "service_name",
        "cpu",
        "memory_mib",
        "desired_count",
        "execution_role_arn",
        "task_role_arn",
        "log_group_name",
        "log_group_arn"
      ],
      "properties": {
        "family": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$"},
        "service_name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$"},
        "cpu": {"enum": [256, 512, 1024, 2048, 4096, 8192, 16384]},
        "memory_mib": {"type": "integer", "minimum": 512, "maximum": 122880},
        "desired_count": {"type": "integer", "minimum": 2, "maximum": 100},
        "execution_role_arn": {"type": "string", "minLength": 1, "maxLength": 2048},
        "task_role_arn": {"type": "string", "minLength": 1, "maxLength": 2048},
        "log_group_name": {"type": "string", "pattern": "^/[A-Za-z0-9_./#-]{1,511}$"},
        "log_group_arn": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_arn",
        "subnet_ids",
        "security_group_ids",
        "target_group_arn",
        "target_type",
        "health_check_path",
        "assign_public_ip"
      ],
      "properties": {
        "cluster_arn": {"type": "string", "minLength": 1, "maxLength": 2048},
        "subnet_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^subnet-[0-9a-f]{8,17}$"}
        },
        "security_group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sg-[0-9a-f]{8,17}$"}
        },
        "target_group_arn": {"type": "string", "minLength": 1, "maxLength": 2048},
        "target_type": {"const": "ip"},
        "health_check_path": {"const": "/ready"},
        "assign_public_ip": {"const": false}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "data_key_arn",
        "routing_signing_key_arn"
      ],
      "properties": {
        "table_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{3,255}$"},
        "data_key_arn": {"type": "string", "minLength": 1, "maxLength": 2048},
        "routing_signing_key_arn": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "tenant_claim", "project_claim"],
      "properties": {
        "issuer": {"type": "string", "format": "uri", "pattern": "^https://"},
        "audience": {"type": "string", "minLength": 1, "maxLength": 512},
        "tenant_claim": {"type": "string", "minLength": 1, "maxLength": 256},
        "project_claim": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
