        <mxCell id="q14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF991F;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.8" edge="1" source="path_direct" target="llm" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="430" /><mxPoint x="735" y="430" /><mxPoint x="735" y="351" /></Array></mxGeometry></mxCell>
