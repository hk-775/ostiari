  <diagram id="components" name="Component Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="AxonLLM Component Architecture" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="470" y="10" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="sub3" value="Shared services are assembled in src/gateway/bootstrap.py and reused by HTTP and AgentCore entry points" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#5E6C84" vertex="1" parent="1"><mxGeometry x="350" y="50" width="900" height="24" as="geometry" /></mxCell>

        <mxCell id="entry" value="Entrypoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4C9AFF;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#0747A6" vertex="1" parent="1"><mxGeometry x="30" y="100" width="230" height="210" as="geometry" /></mxCell>
        <mxCell id="e_serve" value="Starlette&#xa;native + OpenAI APIs&#xa;admin + browser UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="50" y="140" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="e_agentcore" value="AgentCoreAdapter&#xa;validated actions + schemas&#xa;OIDC-only invocation identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="50" y="210" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="e_cli" value="CLI and operations scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="50" y="280" width="190" height="35" as="geometry" /></mxCell>

        <mxCell id="cfg" value="Configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5E6C84;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#42526E" vertex="1" parent="1"><mxGeometry x="30" y="350" width="230" height="260" as="geometry" /></mxCell>
        <mxCell id="cfgfiles" value="AppConfig + environment&#xa;&#xa;models.yaml: logical mappings&#xa;pricing.yaml: billing rates&#xa;leaderboard.yaml: quality data&#xa;ensemble.yaml: panel presets&#xa;spokes.yaml: region topology&#xa;&#xa;Provider credentials:&#xa;local env/YAML or exact&#xa;Secrets Manager version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#5E6C84;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="50" y="390" width="190" height="195" as="geometry" /></mxCell>

        <mxCell id="mw" value="HTTP trust boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF5630;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#BF2600" vertex="1" parent="1"><mxGeometry x="300" y="100" width="255" height="245" as="geometry" /></mxCell>
        <mxCell id="mw1" value="ControlPlaneHTTPMiddleware&#xa;body bounds | CSRF | headers&#xa;&#xa;AuthMiddleware&#xa;browser | ALB | OIDC | Axon key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="320" y="140" width="215" height="85" as="geometry" /></mxCell>
        <mxCell id="mw2" value="CanonicalPrincipalResolver&#xa;TenantAuthorizationMiddleware&#xa;AdminRBACMiddleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="320" y="240" width="215" height="65" as="geometry" /></mxCell>
        <mxCell id="mw3" value="SecurityMiddleware route marker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="320" y="315" width="215" height="35" as="geometry" /></mxCell>

        <mxCell id="idsvc" value="Identity and access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6554C0;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#403294" vertex="1" parent="1"><mxGeometry x="300" y="385" width="255" height="225" as="geometry" /></mxCell>
        <mxCell id="idlist" value="OIDCService: JWT + ALB verification&#xa;BrowserSessionService: PKCE + sessions&#xa;APIKeyService: hash + rotate/revoke&#xa;ScimStore: user/group convergence&#xa;SamlService: Cognito handoff only&#xa;Dynamo principal/project repositories&#xa;Baseline RBAC + optional Cedar narrowing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="320" y="425" width="215" height="160" as="geometry" /></mxCell>

        <mxCell id="core" value="GatewayAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;align=center;spacingTop=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="600" y="100" width="370" height="135" as="geometry" /></mxCell>
        <mxCell id="corenote" value="Chat orchestration&#xa;validation | governance | safety&#xa;cache | routing | accounting | output policy&#xa;normal + policy-aware streaming" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="620" y="145" width="330" height="70" as="geometry" /></mxCell>

        <mxCell id="routing" value="Routing and execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF991F;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#974F0C" vertex="1" parent="1"><mxGeometry x="600" y="270" width="370" height="320" as="geometry" /></mxCell>
        <mxCell id="r_router" value="Router&#xa;strategy selection | retry | fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="620" y="310" width="330" height="50" as="geometry" /></mxCell>
        <mxCell id="r_smart" value="SmartRoutingStrategy&#xa;task classification + quality/cost scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="620" y="375" width="330" height="50" as="geometry" /></mxCell>
        <mxCell id="r_ens" value="EnsembleStrategy&#xa;parallel panel + quorum + judge synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="620" y="440" width="330" height="50" as="geometry" /></mxCell>
        <mxCell id="r_region" value="RegionRouter + route pools&#xa;residency | health | capacity | recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="620" y="505" width="330" height="50" as="geometry" /></mxCell>
        <mxCell id="r_reg" value="ModelRegistry | RequestValidator | ProviderHealthTracker" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#5E6C84" vertex="1" parent="1"><mxGeometry x="620" y="560" width="330" height="18" as="geometry" /></mxCell>

        <mxCell id="gov" value="Governance and cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#36B37E;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#006644" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="270" height="245" as="geometry" /></mxCell>
        <mxCell id="govlist" value="PolicyHierarchyResolver&#xa;QuotaEnforcer + fleet admission&#xa;RateLimiter&#xa;budget reservation/finalization&#xa;CostTracker + pricing&#xa;project/user model restrictions&#xa;exact + semantic cache&#xa;efficiency analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="230" height="175" as="geometry" /></mxCell>

        <mxCell id="sec" value="Safety and evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF5630;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#BF2600" vertex="1" parent="1"><mxGeometry x="1010" y="385" width="270" height="225" as="geometry" /></mxCell>
        <mxCell id="seclist" value="PromptInjectionDetector&#xa;PIIRedactor + optional Comprehend&#xa;GuardrailEngine: input + output checks&#xa;AuditTrail: metadata hash chain&#xa;EventDispatcher: FIFO outbox + DLQ&#xa;TraceForwarder or OTLP export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1030" y="425" width="230" height="155" as="geometry" /></mxCell>

        <mxCell id="prov" value="Provider layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00875A;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#006644" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="250" height="280" as="geometry" /></mxCell>
        <mxCell id="provlist" value="MultiProviderFactory&#xa;ProviderRoutePool&#xa;AdapterRegistry: 13 adapters&#xa;&#xa;AWS IAM: Bedrock + Mantle&#xa;HTTPS API keys: enabled HTTP providers&#xa;&#xa;OpenAI-shaped request/response&#xa;and tool-call translation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="210" height="205" as="geometry" /></mxCell>

        <mxCell id="obs" value="Operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4C9AFF;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=7;fontColor=#0747A6" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="250" height="190" as="geometry" /></mxCell>
        <mxCell id="obslist" value="Readiness dependency checks&#xa;CloudWatch logs/metrics/alarms&#xa;usage and cost dashboard&#xa;audit verification and export&#xa;backups and signed deployment evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1340" y="460" width="210" height="120" as="geometry" /></mxCell>

        <mxCell id="querysvc" value="Governed QueryService&#xa;HTTP /v1/query and AgentCore query share the same AST policy, datasource binding, Athena executor, admission, lifecycle, reconciliation, and durable audit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="600" y="630" width="370" height="115" as="geometry" /></mxCell>
