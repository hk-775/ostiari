        <mxCell id="path_ens" value="Ensemble&#xa;parallel panel&#xa;quorum + fallback&#xa;judge synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="555" y="250" width="140" height="150" as="geometry" /></mxCell>
        <mxCell id="llm" value="Provider call&#xa;adapter translation&#xa;route-pool health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="755" y="275" width="145" height="95" as="geometry" /></mxCell>
        <mxCell id="p15" value="Finalize usage, cost,&#xa;budget, trace, and spend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="935" y="275" width="150" height="95" as="geometry" /></mxCell>
        <mxCell id="p12" value="Output&#xa;guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1120" y="275" width="110" height="75" as="geometry" /></mxCell>
        <mxCell id="p13" value="Output PII&#xa;restore caller values&#xa;redact new PII" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1260" y="265" width="125" height="95" as="geometry" /></mxCell>
        <mxCell id="p14" value="Durable audit&#xa;+ PII/security events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1415" y="275" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="p17" value="Session + eligible&#xa;post-policy cache write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1110" y="410" width="160" height="65" as="geometry" /></mxCell>
        <mxCell id="p18" value="JSON or SSE response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1300" y="410" width="150" height="65" as="geometry" /></mxCell>
        <mxCell id="resp" value="Caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=11;fontStyle=1;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1480" y="410" width="75" height="65" as="geometry" /></mxCell>

        <mxCell id="box1" value="Routing&#xa;Round robin | weighted | least latency | cost optimized | smart | ensemble. Retryable failures use bounded backoff and the remaining fallback chain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FF991F;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="30" y="550" width="285" height="125" as="geometry" /></mxCell>
        <mxCell id="box2" value="Hierarchy and admission&#xa;Budget/rate/token limits use the tightest value. Allowed models/providers intersect. Durable reservation protects concurrent fleet spend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="335" y="550" width="285" height="125" as="geometry" /></mxCell>
        <mxCell id="box3" value="Safety&#xa;Input NER failure degrades to regex-only. Configured output detector failure withholds the response. A blocked output can still incur provider cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="640" y="550" width="285" height="125" as="geometry" /></mxCell>
        <mxCell id="box4" value="Cache&#xa;Tenant/project scoped and process-local. Hits re-run current output policy and audit. Streaming, tools, redacted PII, smart, and ensemble requests do not write chat cache entries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="945" y="550" width="285" height="125" as="geometry" /></mxCell>
        <mxCell id="box5" value="Streaming&#xa;Policy-free supported routes relay chunks. Output inspection buffers a bounded complete response. Fallback ends after the first provider byte; accounting finalizes on success, failure, cancel, or abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#172B4D" vertex="1" parent="1"><mxGeometry x="1250" y="550" width="305" height="125" as="geometry" /></mxCell>

        <mxCell id="q0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C9AFF;strokeWidth=2;endArrow=block;endFill=1" edge="1" source="p0" target="p1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C9AFF;strokeWidth=2;endArrow=block;endFill=1" edge="1" source="p1" target="p3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#36B37E;strokeWidth=2;endArrow=block;endFill=1" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF5630;strokeWidth=2;endArrow=block;endFill=1" edge="1" source="p4" target="p5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF5630;strokeWidth=2;endArrow=block;endFill=1" edge="1" source="p5" target="p6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
