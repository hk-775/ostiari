{
  "family": "ostiari-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ostiari-gateway-task-role",
  "containerDefinitions": [
    {
      "name": "ostiari-gateway",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ostiari-gateway@sha256:REPLACE_WITH_64_HEX_DIGEST",
      "essential": true,
      "stopTimeout": 30,
      "portMappings": [
        {
          "containerPort": 8421,
          "protocol": "tcp"
        }
      ],
      "user": "10001:10001",
      "readonlyRootFilesystem": true,
      "linuxParameters": {
        "capabilities": { "drop": ["ALL"] },
        "initProcessEnabled": true
      },
      "healthCheck": {
        "command": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8421/health', timeout=4).read()"],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "environment": [
        { "name": "OSTIARI_GATEWAY_ID", "value": "gateway-1" },
        { "name": "OSTIARI_CONTROL_PLANE_URL", "value": "http://control-plane.internal:8400" },
        { "name": "OSTIARI_PORT", "value": "8421" },
        { "name": "OSTIARI_ADVERTISE_HOST", "value": "gateway.internal" },
        { "name": "OSTIARI_ENV", "value": "production" },
        { "name": "OSTIARI_TENANCY_MODE", "value": "single" },
        { "name": "OSTIARI_ORG_ID", "value": "REPLACE_ORG_ID" },
        { "name": "OSTIARI_GATEWAY_AUTH", "value": "required" },
        { "name": "OSTIARI_OIDC_ISSUER", "value": "https://REPLACE_OIDC_ISSUER" },
        { "name": "OSTIARI_OIDC_AUDIENCE", "value": "REPLACE_GATEWAY_AUDIENCE" },
        { "name": "OSTIARI_WORKLOAD_TOKEN_URL", "value": "https://REPLACE_WORKLOAD_ISSUER/oauth2/token" },
        { "name": "OSTIARI_WORKLOAD_CLIENT_ID", "value": "REPLACE_GATEWAY_WORKLOAD_CLIENT_ID" },
        { "name": "OSTIARI_WORKLOAD_TOKEN_AUDIENCE", "value": "ostiari-control-plane" },
        { "name": "OSTIARI_GATEWAY_RATE_LIMIT_RPM", "value": "600" },
        { "name": "OSTIARI_REQUIRE_REDIS", "value": "true" },
        { "name": "OSTIARI_REQUIRE_AXON", "value": "true" },
        { "name": "OSTIARI_FAIL_CLOSED_ON_CP_LOSS", "value": "true" },
        { "name": "OSTIARI_HITL", "value": "on" },
        { "name": "OSTIARI_X402_MODE", "value": "live" }
      ],
      "secrets": [
        {
          "name": "OSTIARI_CONFIG_ADMIN_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/config-admin-key"
        },
        {
          "name": "OSTIARI_WORKLOAD_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/gateway-workload-client-secret"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/anthropic-api-key"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/openai-api-key"
        },
        {
          "name": "OSTIARI_REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/redis-url"
        },
        {
          "name": "OSTIARI_X402_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/x402-private-key"
        },
        {
          "name": "OSTIARI_X402_ALLOWED_ASSETS",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ostiari/x402-allowed-assets"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ostiari-gateway",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "gateway",
          "mode": "blocking"
        }
      }
    }
  ]
}
