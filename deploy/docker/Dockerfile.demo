# Local-only demo services and idempotent seed jobs.
FROM python:3.12-alpine@sha256:4b5b91c1040aeb90137a7ed5235e3caf7a1a45da015066c5305fb64e70262ba2

RUN pip install --no-cache-dir "fastapi>=0.100,<1" "uvicorn>=0.20,<1"

WORKDIR /app

COPY gateway/demo_tools_server.py ./
COPY gateway/register_demo_tools.py ./
COPY gateway/register_demo_payments.py ./

RUN addgroup -S -g 10001 ostiari \
    && adduser -S -D -H -u 10001 -G ostiari ostiari

USER 10001:10001
EXPOSE 9300

CMD ["python", "demo_tools_server.py"]
