# Ostiari control-plane backend image.
#
#   docker build -f deploy/docker/Dockerfile.control-plane -t ostiari-control-plane:latest .
FROM python:3.12-alpine@sha256:4b5b91c1040aeb90137a7ed5235e3caf7a1a45da015066c5305fb64e70262ba2 AS builder

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN python -m venv "${VIRTUAL_ENV}"

WORKDIR /build

# The control plane imports the local core package but does not declare it as a
# published dependency, so install it from source first.
COPY pyproject.toml README.md ./core/
COPY src/ ./core/src/
RUN pip install --no-cache-dir ./core

COPY control-plane/backend/pyproject.toml ./control-plane/
COPY control-plane/backend/control_plane/ ./control-plane/control_plane/
# Include AWS discovery and SQLite support. Production uses asyncpg/PostgreSQL.
RUN pip install --no-cache-dir "./control-plane[aws]" "aiosqlite>=0.19"

FROM python:3.12-alpine@sha256:4b5b91c1040aeb90137a7ed5235e3caf7a1a45da015066c5305fb64e70262ba2

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV OSTIARI_DATA_DIR=/data
ENV DATABASE_URL="sqlite+aiosqlite:////data/control_plane.db"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY control-plane/backend/main.py ./
COPY control-plane/backend/alembic.ini ./
COPY control-plane/backend/alembic/ alembic/

RUN addgroup -S -g 10001 ostiari \
    && adduser -S -D -H -u 10001 -G ostiari ostiari \
    && mkdir -p /data \
    && chown 10001:10001 /data

USER 10001:10001

EXPOSE 8400

CMD ["python", "main.py"]
