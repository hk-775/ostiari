# Ostiari control-plane frontend (React/Vite) served by a minimal static binary.
#
#   docker build -f deploy/docker/Dockerfile.frontend \
#     --build-arg VITE_API_URL=http://localhost:8400 -t ostiari-frontend:latest .
#
# NOTE: VITE_API_URL is baked into the bundle at build time and is called from
# the user's BROWSER, so it must be reachable from the browser (e.g. the
# published host port of the backend), not from inside the container network.
FROM node:24.16.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build
WORKDIR /app
COPY control-plane/frontend/package.json control-plane/frontend/package-lock.json* ./
RUN npm ci
COPY control-plane/frontend/ ./
ARG VITE_API_URL=http://localhost:8400
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_DEMO_LOGIN=false
ENV VITE_DEMO_LOGIN=$VITE_DEMO_LOGIN
RUN npm run build

# Compile a static, standard-library-only server. The digest pins the complete
# multi-architecture builder set; the final runtime contains none of its files.
FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS server-build
WORKDIR /src
COPY deploy/docker/frontend_server.go ./
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/frontend-server \
    frontend_server.go

# The package-free runtime has no shell, package manager, or writable state.
FROM scratch
COPY --from=server-build --chown=101:101 /out/frontend-server /frontend-server
COPY --from=build --chown=101:101 /app/dist /usr/share/ostiari
USER 101:101
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["/frontend-server", "--healthcheck"]
ENTRYPOINT ["/frontend-server"]
