# Ostiari control-plane frontend (React/Vite) served as static assets by nginx.
#
#   docker build -f deploy/docker/Dockerfile.frontend \
#     --build-arg VITE_API_URL=http://localhost:8400 -t ostiari-frontend:latest .
#
# NOTE: VITE_API_URL is baked into the bundle at build time and is called from
# the user's BROWSER, so it must be reachable from the browser (e.g. the
# published host port of the backend), not from inside the container network.
FROM node:24.16.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build
WORKDIR /app
COPY control-plane/frontend/package.json control-plane/frontend/package-lock.json* ./
RUN npm ci
COPY control-plane/frontend/ ./
ARG VITE_API_URL=http://localhost:8400
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_DEMO_LOGIN=false
ENV VITE_DEMO_LOGIN=$VITE_DEMO_LOGIN
RUN npm run build

FROM nginx:1.31.1-alpine@sha256:8b1e78743a03dbb2c95171cc58639fef29abc8816598e27fb910ed2e621e589a
COPY --from=build /app/dist /usr/share/nginx/html
# SPA routing: serve index.html for unknown paths so client-side routes work.
#
# Listens on IPv6 as well as IPv4 explicitly. Upstream's entrypoint normally adds
# the IPv6 line at boot, but it can't rewrite conf.d on a read-only root
# filesystem — and then `localhost` inside the container resolves to ::1, so the
# container healthcheck (`wget http://localhost:9000/`) gets connection-refused
# while the site itself serves fine over IPv4. That reads as a broken app when
# only the probe is broken. Declaring both here removes the dependency on that
# script entirely.
RUN printf 'server {\n\
  listen 9000;\n\
  listen [::]:9000;\n\
  root /usr/share/nginx/html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Run as the image's own non-root nginx user (uid 101) rather than root.
#
# Upstream nginx Alpine images start their master as root and only drop workers to
# `nginx`, so the master keeps root for the lifetime of the container. Several
# things have to change for the master itself to run unprivileged:
#
#   1. The pid file. Default is /var/run/nginx.pid, a root-owned dir.
#   2. The five temp dirs nginx mkdir()s on startup under /var/cache/nginx. It
#      fails hard ([emerg] mkdir ... Permission denied, exit 1) if it can't
#      create them.
#   3. The `user nginx;` directive, which is meaningless without root and logs a
#      warning on every boot.
#
# All of (1) and (2) are pointed at /dev/shm. OCI runtimes provide that tmpfs as
# writable to non-root users even when the image root is read-only. This avoids a
# platform-specific writable volume whose root arrives owned by uid 0 on Fargate.
#
# The listen port (9000) is already above 1024, so binding needs no capability.
RUN sed -i -e '/^user /d' -e 's#^pid .*#pid /dev/shm/nginx.pid;#' /etc/nginx/nginx.conf \
    && sed -i '/^http {/a\    client_body_temp_path /dev/shm/client_temp;\n    proxy_temp_path /dev/shm/proxy_temp;\n    fastcgi_temp_path /dev/shm/fastcgi_temp;\n    uwsgi_temp_path /dev/shm/uwsgi_temp;\n    scgi_temp_path /dev/shm/scgi_temp;' /etc/nginx/nginx.conf \
    && chown -R 101:101 /etc/nginx/conf.d

USER 101:101
EXPOSE 9000
CMD ["nginx", "-g", "daemon off;"]
