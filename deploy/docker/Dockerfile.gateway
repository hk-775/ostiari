# Ostiari gateway image. Built from the repository root so the local `ostiari`
# package can be installed before the gateway package.
#
#   docker build -f deploy/docker/Dockerfile.gateway -t ostiari-gateway:latest .
FROM python:3.12-alpine@sha256:4b5b91c1040aeb90137a7ed5235e3caf7a1a45da015066c5305fb64e70262ba2 AS builder

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN python -m venv "${VIRTUAL_ENV}"

WORKDIR /build

COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir .

COPY vendor/axonllm/pyproject.toml vendor/axonllm/README.md \
     vendor/axonllm/LICENSE vendor/axonllm/THIRD_PARTY_NOTICES.md \
     vendor/axonllm/
COPY vendor/axonllm/axonllm/ vendor/axonllm/axonllm/
COPY vendor/axonllm/src/ vendor/axonllm/src/
RUN pip install --no-cache-dir "./vendor/axonllm[server]"

COPY gateway/pyproject.toml gateway/
COPY gateway/ostiari_gateway/ gateway/ostiari_gateway/
RUN pip install --no-cache-dir "./gateway[payments,redis]"

FROM python:3.12-alpine@sha256:4b5b91c1040aeb90137a7ed5235e3caf7a1a45da015066c5305fb64e70262ba2

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV OSTIARI_AXON_ROOT=/opt/axonllm
# OCI runtimes provide /dev/shm as a writable tmpfs even with a read-only root.
# Config pushes render the active policy to a process-lifetime temporary file.
ENV TMPDIR=/dev/shm

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY vendor/axonllm/config/ /opt/axonllm/config/
COPY vendor/axonllm/LICENSE vendor/axonllm/THIRD_PARTY_NOTICES.md /opt/axonllm/

RUN addgroup -S -g 10001 ostiari \
    && adduser -S -D -H -u 10001 -G ostiari ostiari

USER 10001:10001

EXPOSE 8421

ENTRYPOINT ["ostiari-gateway"]
CMD ["--host", "0.0.0.0"]
