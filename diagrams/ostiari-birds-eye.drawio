          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-any" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.72;strokeColor=#0ea5e9;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="agent-any" target="gateway-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS: Gateway → Tools ===== -->
        <mxCell id="arrow-gw-tools" value="HTTP proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;strokeColor=#16a34a;strokeWidth=2;fontSize=8;fontColor=#16a34a;" edge="1" parent="1" source="gateway-group" target="tools-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS: Gateway → Agent-as-Tool ===== -->
        <mxCell id="arrow-gw-agent-tool" value="Agent-as-Tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;exitX=1;exitY=0.38;entryX=0;entryY=0.5;strokeColor=#d97706;strokeWidth=2;fontSize=8;fontColor=#d97706;" edge="1" parent="1" source="gateway-group" target="agent-tool-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS: Gateway → MCP ===== -->
        <mxCell id="arrow-gw-mcp" value="MCP protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;exitX=1;exitY=0.58;entryX=0;entryY=0.5;strokeColor=#7c3aed;strokeWidth=2;fontSize=8;fontColor=#7c3aed;" edge="1" parent="1" source="gateway-group" target="mcp-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS: Gateway → LLM ===== -->
        <mxCell id="arrow-gw-llm" value="LLM calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;exitX=1;exitY=0.78;entryX=0;entryY=0.5;strokeColor=#ea580c;strokeWidth=2;fontSize=8;fontColor=#ea580c;" edge="1" parent="1" source="gateway-group" target="llm-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS: Control Plane ↔ Gateway ===== -->
        <mxCell id="arrow-cp-gw" value="Push config · Receive traces + costs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;exitX=0;exitY=0.8;entryX=0.85;entryY=0;strokeColor=#a855f7;strokeWidth=2;dashed=1;fontSize=8;fontColor=#7e22ce;" edge="1" parent="1" source="cp-group" target="gateway-group">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="340" />
              <mxPoint x="800" y="340" />
              <mxPoint x="800" y="100" />
              <mxPoint x="709" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e5e5e5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="400" width="430" height="310" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="HOW IT WORKS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="1150" y="410" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="&lt;b&gt;PATH 1:&lt;/b&gt; Agent sends POST /tool/{action} → Orchestrator → Auth → Quota → Policy → Tool Router → Execute" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="435" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="&lt;b&gt;PATH 2:&lt;/b&gt; Agent sends POST /invoke (intent) → Orchestrator → Auth → Quota → AxonLLM → LLM generates tool plan → Auth → Policy → Tool Router → Execute → AxonLLM → Final response" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="470" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="&lt;b&gt;Orchestrator:&lt;/b&gt; Single entry/exit point. All responses return here before going to agent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="515" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-4" value="&lt;b&gt;Tool Router:&lt;/b&gt; Resolves tool name → HTTP endpoint, MCP server, or Agent-as-Tool" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="540" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-5" value="&lt;b&gt;AxonLLM:&lt;/b&gt; Smart routing, A/B testing, fallback chains, PII redaction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="565" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-6" value="&lt;b&gt;Dual Quota:&lt;/b&gt; #1 pre-LLM (can agent afford it?) + #2 per-tool (can agent afford this tool?)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="590" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-7" value="&lt;b&gt;Control Plane:&lt;/b&gt; Central UI manages N gateways. Gateways report traces + costs in real-time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444;" vertex="1" parent="1">
          <mxGeometry x="1150" y="615" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend-key" value="&lt;b&gt;Agent writes:&lt;/b&gt; POST http://gateway:8421/tool/send_email {to, body}&lt;br&gt;&lt;b&gt;Agent doesn't:&lt;/b&gt; import libraries, manage keys, write safety code, pick models, call LLMs directly" style="text;html=1;strokeColor=none;fillColor=#e0f2fe;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#0369a1;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="650" width="400" height="45" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
